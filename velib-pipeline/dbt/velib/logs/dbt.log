  create  table "velib"."gold"."gold_station_latest__dbt_tmp"
  
  
    as
  
  (
    -- Dernier état connu de chaque station (pour la carte du dashboard)
with ranked as (
    select
        s.*,
        row_number() over (partition by s.station_id order by s.reported_at desc) as rn
    from "velib"."silver"."station_status" s
)

select
    r.station_id,
    i.name,
    i.lat,
    i.lon,
    i.capacity,
    r.num_bikes_available,
    r.bikes_mechanical,
    r.bikes_ebike,
    r.num_docks_available,
    r.is_renting,
    r.is_returning,
    (r.reported_at at time zone 'UTC') at time zone 'Europe/Paris' as reported_local
from ranked r
join "velib"."silver"."station_information" i using (station_id)
where r.rn = 1
  );
  
[0m10:30:14.057854 [debug] [Thread-1 (]: On model.velib.gold_station_hourly: /* {"app": "dbt", "dbt_version": "1.13.0b1", "profile_name": "velib", "target_name": "dev", "node_id": "model.velib.gold_station_hourly"} */

  
    

  create  table "velib"."gold"."gold_station_hourly__dbt_tmp"
  
  
    as
  
  (
    -- Disponibilité moyenne par station et par heure (heure de Paris)
with status as (
    select
        station_id,
        num_bikes_available,
        num_docks_available,
        (reported_at at time zone 'UTC') at time zone 'Europe/Paris' as reported_local
    from "velib"."silver"."station_status"
    where is_installed
)

select
    s.station_id,
    i.name,
    i.capacity,
    date_trunc('hour', s.reported_local)                        as hour_local,
    count(*)                                                    as nb_reports,
    round(avg(s.num_bikes_available), 2)                        as avg_bikes,
    round(avg(s.num_docks_available), 2)                        as avg_docks,
    min(s.num_bikes_available)                                  as min_bikes,
    max(s.num_bikes_available)                                  as max_bikes,
    round(avg(s.num_bikes_available::numeric / nullif(i.capacity, 0)), 3) as avg_fill_rate
from status s
join "velib"."silver"."station_information" i using (station_id)
group by 1, 2, 3, 4
  );
  
