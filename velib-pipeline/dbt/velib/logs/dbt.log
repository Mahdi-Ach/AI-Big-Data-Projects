  create  table "velib"."gold"."gold_remplissage_horaire__dbt_tmp"
  
  
    as
  
  (
    

WITH base AS (
    SELECT
        station_id,
        name,
        date,
        EXTRACT(HOUR FROM (ingested_at::timestamptz)) AS heure,
        num_bikes_available,
        capacity,
        taux_remplissage
    FROM "velib"."public"."silver_station_status_enriched"
    WHERE capacity > 0
      AND num_bikes_available IS NOT NULL
)

SELECT
    station_id,
    name,
    date,
    heure,
    COUNT(*)                            AS nb_mesures,
    AVG(num_bikes_available)::numeric(10,2) AS avg_bikes,
    AVG(capacity)::numeric(10,2)             AS avg_capacity,
    AVG(taux_remplissage)::numeric(5,3)      AS avg_taux_remplissage
FROM base
GROUP BY station_id, name, date, heure
  );
  
[0m16:10:52.859613 [debug] [Thread-1 (]: Opening a new connection, currently in state closed
[0m16:10:52.860670 [debug] [Thread-2 (]: Using postgres connection "model.velib.gold_stations_tension"
[0m16:10:52.866109 [debug] [Thread-2 (]: On model.velib.gold_stations_tension: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "velib", "target_name": "dev", "node_id": "model.velib.gold_stations_tension"} */

  
    

  create  table "velib"."gold"."gold_stations_tension__dbt_tmp"
  
  
    as
  
  (
    

WITH base AS (
    SELECT
        station_id,
        name,
        date,
        num_bikes_available,
        capacity
    FROM "velib"."public"."silver_station_status_enriched"
    WHERE capacity > 0
      AND num_bikes_available IS NOT NULL
)

SELECT
    station_id,
    name,
    COUNT(*)                                          AS nb_mesures,
    SUM(CASE WHEN num_bikes_available = 0 THEN 1 ELSE 0 END) AS nb_fois_vide,
    SUM(CASE WHEN num_bikes_available = capacity THEN 1 ELSE 0 END) AS nb_fois_pleine,
    ROUND(100.0 * SUM(CASE WHEN num_bikes_available = 0 THEN 1 ELSE 0 END) / COUNT(*), 2) AS pct_vide,
    ROUND(100.0 * SUM(CASE WHEN num_bikes_available = capacity THEN 1 ELSE 0 END) / COUNT(*), 2) AS pct_pleine
FROM base
GROUP BY station_id, name
HAVING COUNT(*) >= 10
ORDER BY pct_vide DESC, pct_pleine DESC
  );
  
